# REQUIRED FILE NAME: keystore.properties (this example file is NOT read by Gradle).
# Copy this file to keystore.properties in this folder (same directory as this example).
# Paths are relative to the repository root (parent of the android/ folder).

storeFile=android/release.keystore
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password
